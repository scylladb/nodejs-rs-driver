{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "commitBodyTable": true,
    "description": "Renovate keeps the ScyllaDB version used by CI and the docs Python dependencies up to date. The other ecosystems (npm, cargo, GitHub Actions) are handled by Dependabot, hence the restricted `enabledManagers`.",
    "enabledManagers": [
        "custom.regex",
        "pep621"
    ],
    // See https://crontab.cronhub.io/ for cheatsheet on crontab syntax and translation to natural language.
    "schedule": [
        "* * * * 6"
    ],
    // See https://docs.renovatebot.com/modules/manager/regex/ to learn how this works.
    "customManagers": [
        {
            "description": "Keep the ScyllaDB version used by our test clusters current. `semver` versioning is deliberate: it skips the truncated tags (`2026.3`), `latest` and prereleases that Docker Hub publishes alongside real releases, none of which are usable here - see the comments in `scylla_version.env`.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^scylla_version\\.env$/"
            ],
            "matchStrings": [
                "(?m)^SCYLLA_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)$"
            ],
            "depNameTemplate": "scylladb/scylla",
            "datasourceTemplate": "docker",
            "versioningTemplate": "semver" // Prevents updates to tags other than full versions.
        }
    ],
    "packageRules": [
        {
            "description": "Update docs Python dependencies together, including transitive dependencies through lock file maintenance",
            "matchManagers": [
                "pep621"
            ],
            "matchFileNames": [
                "docs/pyproject.toml",
                "docs/uv.lock"
            ],
            "rangeStrategy": "update-lockfile",
            "groupName": "docs",
            "lockFileMaintenance": {
                "enabled": true,
                "schedule": [
                    "* * * * 6"
                ]
            }
        },
        {
            "description": "Keep the docs Python requirement aligned with the documentation build environment",
            "matchManagers": [
                "pep621"
            ],
            "matchFileNames": [
                "docs/pyproject.toml"
            ],
            "matchDepTypes": [
                "requires-python"
            ],
            "enabled": false
        }
    ]
}
