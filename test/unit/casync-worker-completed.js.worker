"use strict";

const { parentPort, workerData } = require("worker_threads");
const rust = require("../../index");
require("../../lib/client");

const blocked = new Int32Array(new SharedArrayBuffer(4));
const size = workerData?.retained ? 2048 : 4;
for (let i = 0; i < size; i++) {
    const promise = rust.testsCasyncTrackedResult(i);
    if (workerData?.retained && i === 0) {
        promise.then(() => {
            // The first bounded drain returned its unfinished snapshot to the
            // registry. Freeze in the first reaction before another drain runs.
            rust.testsBridgeAbortNotifications();
            parentPort.postMessage("retained");
            Atomics.wait(blocked, 0, 0);
        });
    }
}
// Do not return to the event loop until every native result has been queued.
const deadline = Date.now() + 5000;
while (rust.testsBridgePendingCompletions() !== size) {
    if (Date.now() > deadline) {
        throw new Error("completion results were not queued");
    }
    Atomics.wait(blocked, 0, 0, 1);
}
// Force the discard path: some Node versions otherwise drain before cleanup.
if (!workerData?.retained) {
    rust.testsBridgeAbortNotifications();
    parentPort.postMessage("completed");
    Atomics.wait(blocked, 0, 0);
}
